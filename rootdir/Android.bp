// Init configuration files

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "root/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "vendor/ueventd.qcom.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.msm.usb.configfs.rc",
    src: "vendor/etc/init/hw/init.msm.usb.configfs.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.nubia.rc",
    src: "vendor/etc/init/hw/init.nubia.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.power.rc",
    src: "vendor/etc/init/hw/init.qcom.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "vendor/etc/init/hw/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.usb.rc",
    src: "vendor/etc/init/hw/init.qcom.usb.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "vendor/etc/init/hw/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// Init scripts

sh_binary {
    name: "init.class_main.sh",
    src: "vendor/bin/init.class_main.sh",
    vendor: true,
}

sh_binary {
    name: "init.nubia.usb.sh",
    src: "vendor/bin/init.nubia.usb.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.early_boot.sh",
    src: "vendor/bin/init.qcom.early_boot.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.mem.sh",
    src: "vendor/bin/init.qcom.mem.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.post_boot.sh",
    src: "vendor/bin/init.qcom.post_boot.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.sh",
    src: "vendor/bin/init.qcom.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.usb.sh",
    src: "vendor/bin/init.qcom.usb.sh",
    vendor: true,
}

sh_binary {
    name: "init.qti.qseecomd.sh",
    src: "vendor/bin/init.qti.qseecomd.sh",
    vendor: true,
}
